{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Carte",
	"slug": "carte",
	"blockTypes": [ "core/group", "core/column" ],
	"styles": {
		"color": {
			"background": "var(--dg-carte)"
		},
		"border": {
			"width": "1px",
			"style": "solid",
			"color": "var(--dg-filet)",
			"radius": "var:custom|radius|md"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|60",
				"right": "var:preset|spacing|60",
				"bottom": "var:preset|spacing|60",
				"left": "var:preset|spacing|60"
			},
			"blockGap": "var:preset|spacing|40"
		}
	}
}
