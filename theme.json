{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "nuit", "name": "Bleu nuit", "color": "#0D2A3A" },
				{ "slug": "vert", "name": "Vert accent", "color": "#C4E86B" },
				{ "slug": "vert-texte", "name": "Vert texte", "color": "#4D7A10" },
				{ "slug": "acier", "name": "Bleu acier", "color": "#3F7398" },
				{ "slug": "brume", "name": "Brume", "color": "#EEF3F6" },
				{ "slug": "blanc", "name": "Blanc", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/dm-sans-400.woff2" ] },
						{ "fontFamily": "DM Sans", "fontWeight": "600", "fontStyle": "normal", "src": [ "file:./assets/fonts/dm-sans-600.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--blanc)", "text": "var(--wp--preset--color--nuit)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--dm-sans)", "fontSize": "1.0625rem", "lineHeight": "1.65" },
		"spacing": { "blockGap": "1.5rem", "padding": { "left": "1.5rem", "right": "1.5rem" } },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--acier)" } },
			"heading": { "typography": { "fontWeight": "600", "lineHeight": "1.2" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--vert)", "text": "var(--wp--preset--color--nuit)" },
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "600" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}
