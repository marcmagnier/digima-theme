{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "nuit", "name": "Bleu nuit", "color": "#0D2A3A" },
				{ "slug": "vert", "name": "Vert accent (fond, ou texte sur bleu nuit)", "color": "#C4E86B" },
				{ "slug": "vert-texte", "name": "Vert texte (sur fond clair)", "color": "#4D7A10" },
				{ "slug": "acier", "name": "Bleu acier", "color": "#3F7398" },
				{ "slug": "brume", "name": "Brume", "color": "#EEF3F6" },
				{ "slug": "blanc", "name": "Blanc", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Petit", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Grand", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Titre", "size": "3rem", "fluid": { "min": "2.125rem", "max": "3.5rem" } }
			],
			"fontFamilies": [
				{
					"slug": "dm-sans",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-400.woff2" ] },
						{ "fontFamily": "DM Sans", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans-600.woff2" ] }
					]
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 6vw, 4.5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 8vw, 6.5rem)" }
			]
		},
		"custom": {
			"radius": { "small": "8px", "medium": "16px", "pill": "999px" }
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|blanc", "text": "var:preset|color|nuit" },
		"typography": {
			"fontFamily": "var:preset|font-family|dm-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1rem, 4vw, 1.5rem)",
				"right": "clamp(1rem, 4vw, 1.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|acier" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|nuit" } }
			},
			"heading": {
				"typography": { "fontWeight": "600", "lineHeight": "1.2", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"button": {
				"color": { "background": "var:preset|color|vert", "text": "var:preset|color|nuit" },
				"border": { "radius": "var:custom|radius|pill" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.3" },
				":hover": { "color": { "background": "var:preset|color|nuit", "text": "var:preset|color|blanc" } },
				":focus": { "color": { "background": "var:preset|color|nuit", "text": "var:preset|color|blanc" } }
			},
			"caption": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "transparent", "text": "currentColor" },
						"border": { "width": "2px", "style": "solid", "color": "currentColor" },
						"spacing": { "padding": { "top": "calc(0.75rem - 2px)", "bottom": "calc(0.75rem - 2px)", "left": "calc(1.5rem - 2px)", "right": "calc(1.5rem - 2px)" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|acier" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var:custom|radius|medium" }
			},
			"core/image": {
				"border": { "radius": "var:custom|radius|small" }
			},
			"core/site-title": {
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|large" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|brume" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}
